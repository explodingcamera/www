---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About Me">
  <div class="about">
    <h1>about me</h1>
    <p>
      I'm a software engineer based in Stuttgart, working on backend systems,
      Rust, WebAssembly, and open-source software.
      <br />
      <br />
      My work focuses on reliable, high-performance software with clear abstractions
      and maintainable architecture. I'm especially interested in systems, infrastructure,
      tooling, and self-hosted platforms.
      <br />
      <br />
      Outside of my professional work, I build open-source software around WebAssembly,
      privacy-focused analytics, and maintain various libraries.<br />
    </p>
    <nav class="profiles" aria-label="Other links">
      <a href="mailto:hi@henrygressmann.de">email</a>
      <a href="https://github.com/explodingcamera" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://www.linkedin.com/in/henrygressmann/" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="https://www.goodreads.com/user/show/129153443-henry" target="_blank" rel="noopener noreferrer">goodreads</a>
      <a href="https://henry.dawdle.space/photos" target="_blank" rel="noopener noreferrer">photos</a>
      <a href="/static/gpg.asc">gpg key</a>
    </nav>
  </div>
</MainLayout>

<style>
  .about {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;

    h1 {
      font-size: 3em;
      color: var(--cyan-accent);
    }

    p {
      font-size: 1.4rem;
      line-height: 1.5;
      max-width: 38rem;
    }

    .profiles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.5em;
      font-size: 1.4rem;
      line-height: 1.5;
      color: #888;

      a {
        color: #888;
        font-weight: 400;
        text-decoration: none;
        transition: color 0.15s ease-out;

        &::before {
          content: "[";
        }

        &::after {
          content: "]";
        }

        &:hover {
          color: white;
        }
      }
    }
  }
</style>
