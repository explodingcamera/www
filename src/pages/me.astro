---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About Me">
  <div class="about">
    <h1>about me</h1>
    <p>
      I'm Henry, currently based in Stuttgart. I work on backend systems, Rust,{" "}
      <a href="https://github.com/explodingcamera/tinywasm" target="_blank" rel="noopener noreferrer">WebAssembly</a>, self-hosted tools and{" "}
      <a href="https://liwan.dev" target="_blank" rel="noopener noreferrer">privacy-focused software</a>.
      <br />
      <br />
      Outside of work, I build <a href="https://github.com/explodingcamera" target="_blank" rel="noopener noreferrer">open-source software</a> and maintain various libraries,
      but I also enjoy <a href="https://henry.dawdle.space/photos" target="_blank" rel="noopener noreferrer">photography</a>, <a href="https://www.goodreads.com/user/show/129153443-henry" target="_blank" rel="noopener noreferrer">reading</a>, and working with electronics and 3D printing.
      I'm especially interested in questions around AI and animal ethics.
    </p>
    <nav class="profiles" aria-label="Other links">
      <a href="mailto:hi@henrygressmann.de">email</a>
      <a href="https://www.linkedin.com/in/henrygressmann/" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="/static/gpg.asc">gpg key</a>
    </nav>
  </div>
</MainLayout>

<style>
  .about {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;

    h1 {
      font-size: 3em;
      color: var(--cyan-accent);
    }

    p {
      font-size: 1.4rem;
      line-height: 1.5;
      max-width: 38rem;
    }

    .profiles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.5em;
      font-size: 1.4rem;
      line-height: 1.5;
      color: #888;

      a {
        color: #888;
        font-weight: 400;
        text-decoration: none;
        transition: color 0.15s ease-out;

        &::before {
          content: "[";
        }

        &::after {
          content: "]";
        }

        &:hover {
          color: white;
        }
      }
    }
  }
</style>
