---
import Link from "../components/Link.astro";
import Layout from "../layouts/MainLayout.astro";
---

<Layout title="henrygressmann.de">
  <div class="home">
    <h2>
      <span>Hi!</span> I'm Henry.

      <br /><br />
      <Link href="/work">my work</Link>
      <br />
      <Link href="/me">about me</Link>
      <br />
      <Link href="mailto:hi@henrygressmann.de">contact</Link>
    </h2>
  </div>
</Layout>

<style>
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;

    h2 {
      font-size: 3rem;
      margin: 1rem 0;
      font-weight: 400;
      max-width: 44rem;

      span,
      a {
        font-weight: 400;
      }

      span {
        color: var(--accent-color);
      }
    }

    @media only screen and (max-width: 60rem) {
      h2 {
        font-size: 5vw;
      }
    }

    @media only screen and (max-device-width: 500px) {
      h2 {
        font-size: 2.6rem;
      }
    }
  }
</style>
