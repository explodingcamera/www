---
type Props = {
	title: string;
	from: string;
	img?: string;
	href?: string;
	text: Array<string | { link: string; name: string }>;
};

const { title, from, img, href, text }: Props = Astro.props;
const primaryLinkIndex = text.findIndex((part) => typeof part !== "string");
---

<div class="project">
  {
    img && (
      <div class="image">
        <img src={`../static/projects/${img}`} alt={title} class:list={{ snowstorm: img === "snowstorm.webp" }} />
      </div>
    )
  }
  <div class="content">
    <h1>
      {title}
      <span>{from}</span>
    </h1>
    <p>
      {
        text.map((part, index) =>
          typeof part === "string" ? (
            part
          ) : (
            <a
              class:list={{ primary: index === primaryLinkIndex }}
              target="_blank"
              rel="noopener noreferrer"
              href={part.link}
            >
              {part.name}
            </a>
          ),
        )
      }
    </p>
  </div>
  {href && <a class="card-link" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${title}`}></a>}
</div>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background: #0e0f10;

    margin-bottom: 1rem;

    .content {
      padding: 1.1rem 1.3rem;
    }

    .image + .content {
      z-index: 1;
      margin-top: -2.5rem;
      padding-top: 0;
    }

    h1 {
      margin-bottom: 1rem;
      display: flex;
      justify-content: space-between;
      font-size: 1.7rem;
      text-transform: lowercase;
      letter-spacing: -1px;
      align-items: flex-start;

      span {
        padding-left: 0.5rem;
        padding-top: 0.5rem;
        font-weight: 400;
        font-feature-settings: "ss12" 1;
        font-size: 1rem;
        color: #cdcdcd;
        letter-spacing: -0.3px;
        word-break: keep-all;
      }
    }

    p {
      color: #d0d0d0;
      font-size: 1.1rem;
      margin: 0;
      line-height: 1.4;
      white-space: pre-line;
    }

    p a:not(.primary) {
      position: relative;
      z-index: 2;
    }

    a.primary::before {
      content: "";
      position: absolute;
      inset: 0;
    }

    a.primary:focus-visible::before {
      outline: 2px solid var(--accent-color);
      outline-offset: -2px;
    }

    .card-link {
      position: absolute;
      z-index: 2;
      inset: 0;
    }

    .card-link:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: -2px;
    }
  }

  .project .image {
    position: relative;
    aspect-ratio: 16/9;
    background-color: black;
    overflow: hidden;
    width: 100%;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom in oklab, transparent 35%, rgb(14 15 16 / 0.45) 70%, #0e0f10);
      pointer-events: none;
    }

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      overflow: hidden;

      &.snowstorm {
        filter: invert(1) contrast(2) hue-rotate(180deg);
      }
    }
  }
</style>
