---
type Props = {
	"aria-label"?: string;
	href: string;
	target?: string;
	prominent?: boolean;
	active?: boolean;
	label?: string;
};

const { target, href, prominent, active, label, "aria-label": ariaLabel } = Astro.props;
const fontColor = active ? "var(--accent-color)" : prominent ? "white" : "#7e7e7e";
---

<a
  aria-label={ariaLabel}
  class="link"
  href={href}
  target={target}
  rel="noopener noreferrer"
  data-active={active && "true"}
>
  {label ? label : <slot />}
</a>

<style define:vars={{ fontColor }}>
  a.link:link,
  a.link:visited {
    transition: color 0.15s ease-out;
    text-decoration: none;
    color: var(--fontColor);
    font-weight: inherit;
  }

  a.link :global(svg) {
    height: 1.4rem;
    width: 1.4rem;
    box-sizing: content-box;
  }

  a.link:hover {
    color: var(--accent-color);
  }
</style>
