---
import Link from "./Link.astro";
type Props = {
	"aria-label"?: string;
	href: string;
	prominent?: boolean;
	class?: string;
	newTab?: boolean;
};

const { href, newTab, prominent, class: className, "aria-label": ariaLabel } = Astro.props;

const url = new URL(Astro.request.url);
const pathname = url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const active = pathname === href;
---

<li class:list={[className, "item"]}>
  <Link
    aria-label={ariaLabel}
    href={href}
    active={active}
    prominent={prominent}
    target={newTab ? "_blank" : ""}
  >
    <slot />
  </Link>
</li>

<style>
  .item {
    display: flex;

    :global(a) {
      padding: 0.3rem;
    }
  }

  .item:last-of-type {
    margin-right: 0;
  }
</style>
