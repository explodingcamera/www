---
import code from "feather-icons/dist/icons/code.svg?raw";
import HeaderItem from "./HeaderItem.astro";
---

<style>
  .header {
    @media print {
      display: none;
    }
  }

  .header ol {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 1.8rem;
    margin: 1rem 0 2rem 0;
    overflow: hidden;
    gap: 0.1rem;
  }

  .header :global(.home) {
    display: none;
  }

  @media only screen and (max-device-width: 500px) {
    .header :global(.home) {
      display: block;
    }
  }

  .header :global(.title) {
    margin-right: auto;
    font-size: 1rem;
    transform: translateY(0);
  }

  @media only screen and (max-device-width: 500px) {
    .header :global(.title) {
      display: none;
    }
  }

  .header :global(svg) {
    transform: translateY(1px);
  }

  .header :global(a.link:hover) {
    color: var(--accent-color);
  }

  .header :global(.title a.link:hover) {
    color: var(--cyan-accent);
  }
</style>

<nav class="header">
  <ol>
    <HeaderItem prominent href="/" class:list={"title"}>
      Henry Gressmann
    </HeaderItem>
    <HeaderItem prominent href="/" class:list={["home"]}> home </HeaderItem>
    <HeaderItem href="https://blog.henrygressmann.de" newTab> blog </HeaderItem>
    <HeaderItem href="/work">work</HeaderItem>
    <HeaderItem href="/me">about</HeaderItem>
    <HeaderItem
      aria-label="GitHub"
      href="https://github.com/explodingcamera"
      newTab
    >
      <Fragment set:html={code} />
    </HeaderItem>
  </ol>
</nav>
